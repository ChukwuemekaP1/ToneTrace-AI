# ==============================================================================
# TONETRACE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and adjust the values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Options: development, test, staging, production
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ToneTrace AI API"
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins (JSON array or comma-separated strings)
# Wildcards ("*") are strictly prohibited in production.
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Server host and port
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. SECURITY & FIRST-PARTY AUTHENTICATION (PHASE 2)
# ------------------------------------------------------------------------------
# WARNING: Setting ALLOW_DEV_AUTH_BYPASS=true is strictly forbidden in production
# and staging environments. The application will refuse to start if enabled there.
ALLOW_DEV_AUTH_BYPASS=false

# First-Party JWT Access Token & Refresh Session Configuration
# In production, AUTH_JWT_SECRET MUST be a cryptographically random string (>= 32 chars).
AUTH_JWT_SECRET=tonetrace-dev-insecure-jwt-secret-do-not-use-in-production-1234567890
AUTH_JWT_ISSUER=tonetrace-auth
AUTH_JWT_AUDIENCE=tonetrace-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_ENABLED=true

# Hackathon Notice: Email verification delivery and password reset delivery workflows
# are deferred for this MVP. Accounts are functional immediately upon registration.

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (NEON POSTGRESQL)
# ------------------------------------------------------------------------------
# Target: Neon Serverless PostgreSQL with pooling / direct connection.
# Connection string format: postgresql+psycopg://user:password@host/dbname?sslmode=require
# DATABASE_URL: Application runtime pooled connection (via PgBouncer pooler endpoint)
DATABASE_URL=postgresql+psycopg://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# DIRECT_URL: Direct unpooled connection used exclusively for Alembic schema migrations
DIRECT_URL=postgresql+psycopg://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application-side connection pool tuning (matched to serverless proxy)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10.0
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_ECHO=false

# ------------------------------------------------------------------------------
# 4. SEARCH & INDEXING (ELASTICSEARCH)
# ------------------------------------------------------------------------------
# Toggle to enable/disable Elasticsearch dependency check & indexing
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=tonetrace_
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=10.0
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_FALLBACK_TO_DB=false

# ------------------------------------------------------------------------------
# 5. AI ENGINE (GOOGLE GEMINI — PHASE 7)
# ------------------------------------------------------------------------------
# Gemini API Key and target model for grounded skincare explanations
# Supported current models: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-4-argon, gemini-3.1-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20.0
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONTEXT_CHARS=16000
AI_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 6. OCR (INGREDIENT & PRODUCT SCANNING)
# ------------------------------------------------------------------------------
# OCR provider options: ocr_space, tesseract, mock
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_BASE_URL=https://api.ocr.space/parse/image
TESSERACT_CMD_PATH=

# ------------------------------------------------------------------------------
# 7. EXTERNAL PRODUCT DATA INTEGRATION (OPEN BEAUTY FACTS & CHANNEL3)
# ------------------------------------------------------------------------------
# Open Beauty Facts (public ODbL licensed cosmetics database)
OPEN_BEAUTY_FACTS_BASE_URL=https://world.openbeautyfacts.org/api/v2
OPEN_BEAUTY_FACTS_USER_AGENT=ToneTraceAI/0.1.0 (contact: admin@tonetrace.app)

# Channel3 API for multi-merchant product discovery and commercial offers
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

# PubMed E-utilities & European Commission CosIng Reference Data (Phase 6)
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_API_KEY=
PUBMED_TOOL_NAME=tonetrace_ai
PUBMED_CONTACT_EMAIL=dev@tonetrace.ai
COSING_API_URL=https://api.tech.ec.europa.eu/search-api/prod/rest/search
COSING_API_KEY=285a77fd-1257-4271-8507-f0c6b2961203
EVIDENCE_CACHE_TTL_HOURS=168

PRODUCT_DATA_API_KEY=
PRODUCT_DATA_API_BASE_URL=https://api.external-cosmetics-db.com/v1

# ------------------------------------------------------------------------------
# 8. SKIN ANALYSIS INTEGRATION (PERFECT CORP / YOUCAM S2S API — PHASE 8)
# ------------------------------------------------------------------------------
# Skin analysis provider options: youcam, mock
SKIN_ANALYSIS_PROVIDER=mock
SKIN_ANALYSIS_API_KEY=
SKIN_ANALYSIS_SECRET_KEY=
SKIN_ANALYSIS_BASE_URL=https://yce-api-01.makeupar.com
SKIN_ANALYSIS_ENDPOINT_URL=https://yce-api-01.makeupar.com
SKIN_ANALYSIS_TIMEOUT_SECONDS=20.0
SKIN_ANALYSIS_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 9. OBJECT STORAGE & IMAGE RETENTION (NEON S3 BUCKET OR POSTGRESQL BYTEA)
# ------------------------------------------------------------------------------
# Options: s3 (Neon Object Storage bucket), postgres (PostgreSQL BYTEA), local
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=local_data/storage
STORAGE_SIGNING_SECRET=tonetrace-storage-signing-secret-change-in-prod-12345
# Neon Object Storage bucket name (e.g. "assets" or "tone-ai")
STORAGE_BUCKET_NAME=assets
# Neon S3 endpoint URL (retrieved from your Neon project branch / storage settings)
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Mandatory for Neon Object Storage (corresponds to forcePathStyle: true in AWS SDK)
STORAGE_FORCE_PATH_STYLE=true
OCR_IMAGE_RETENTION_POLICY=retain
OCR_IMAGE_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 10. UPLOAD POLICIES & CONSTRAINTS
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (e.g., 5242880 = 5MB for PostgreSQL BYTEA MVP)
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_IMAGE_DIMENSION=4096
# Permitted MIME types for facial scans and ingredient labels
UPLOAD_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp"]
