{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tonetrace-ai.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://tonetrace-ai.onrender.com/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
