# ToneTrace AI Frontend Environment Variables
# In local development with Vite dev server, leave VITE_API_BASE_URL empty to use Vite's built-in /api proxy.
# If connecting directly to FastAPI without proxy, set: http://localhost:8000
VITE_API_BASE_URL=

# App version identifier
VITE_APP_VERSION=0.1.0

# Enable/disable the dev-only design system showcase route
VITE_ENABLE_DEV_SHOWCASE=true
